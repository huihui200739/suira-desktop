{
  "name": "suira-desktop",
  "version": "0.2.9",
  "description": "随序 SUIRA — Windows 随手工作台。截图、剪贴板、日历与 Markdown，让零散内容自然接成工作流。",
  "main": "main.js",
  "author": "huihui200739",
  "license": "MIT",
  "scripts": {
    "start": "node tools/dev-start.js",
    "dev": "node tools/dev-start.js --dev",
    "clean": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/clean-dev-artifacts.ps1",
    "test": "node tests/test-shortcut-policy.js && node tests/test-markdown-files.js && node tests/test-window-resize.js && node tests/test-workspace.js && node tests/test-core.js && node tests/test-clipboard-session.js && node tests/test-long-start.js && node tests/test-long-capture.js && node tests/test-long-session.js && node tests/test-region-capture.js && node tests/test-image-editor.js && node tests/test-app-icons.js && node tests/test-icon-disk-cache.js && node tests/test-native-capture.js && node tests/test-clipboard.js && node tests/test-ocr.js && node tests/test-translate.js && node tests/test-notes.js && node tests/test-island-store.js && node tests/test-island.js && node tests/test-island-wake.js && node tests/test-actions.js && node tests/test-capabilities.js && node tests/test-keybindings.js && node tests/test-panel-bindings.js && node tests/test-panel-shortcuts.js && node tests/test-panel-flows.js && node tests/test-return.js && node tests/test-foreground.js && node tests/test-security.js && node tests/test-key-watch.js && node tests/test-display.js && node tests/test-inject.js && node tests/test-diagnostics.js && node tests/test-ui.js && node tests/test-render.js && node tools/panel-shot.js --check && node tools/island-check.js && node tools/notes-check.js && node tools/clipboardbar-check.js && node tools/confirm-check.js && node tools/overlay-check.js && node tools/shortcut-check.js",
    "test:core": "node tests/test-core.js",
    "test:clipboard": "node tests/test-clipboard.js",
    "test:ocr": "node tests/test-ocr.js",
    "test:notes": "node tests/test-notes.js",
    "test:translate": "node tests/test-translate.js",
    "test:clipboardbar": "node tools/clipboardbar-check.js",
    "test:island": "node tests/test-island.js && node tests/test-island-store.js",
    "test:island-store": "node tests/test-island-store.js",
    "test:island-render": "node tools/island-check.js",
    "test:notes-render": "node tools/notes-check.js",
    "test:keywatch": "node tests/test-key-watch.js",
    "test:actions": "node tests/test-actions.js",
    "test:capabilities": "node tests/test-capabilities.js",
    "test:keybindings": "node tests/test-keybindings.js",
    "test:flows": "node tests/test-panel-flows.js",
    "test:return": "node tests/test-return.js",
    "test:foreground": "node tests/test-foreground.js",
    "test:security": "node tests/test-security.js",
    "test:display": "node tests/test-display.js",
    "test:inject": "node tests/test-inject.js",
    "test:ui": "node tests/test-ui.js",
    "test:render": "node tests/test-render.js",
    "test:confirm": "node tools/confirm-check.js",
    "test:overlay": "node tools/overlay-check.js",
    "test:shortcut": "node tools/shortcut-check.js",
    "test:diagnostics": "node tests/test-diagnostics.js",
    "diag": "electron . --diag",
    "verify:electron": "node tools/electron-real-check.js",
    "verify:ipc": "node tools/electron-verify.js",
    "verify:capture": "node tools/electron-capture-check.js",
    "verify:latency": "node tools/latency-live-check.js --idle",
    "audit:batch3": "node tools/fuyin-modules.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "verify:island": "node tools/electron-island-check.js",
    "verify:core": "node tools/electron-core-check.js",
    "verify:notes": "node tools/electron-notes-check.js",
    "test:panel": "node tools/panel-shot.js --check",
    "verify:panel": "node tools/electron-panel-check.js",
    "test:island-wake": "node tests/test-island-wake.js",
    "test:app-icons": "node tests/test-app-icons.js",
    "test:bindings": "node tests/test-panel-bindings.js && node tests/test-panel-shortcuts.js && node tools/panel-shot.js --check",
    "verify:bindings": "node tools/electron-bindings-check.js",
    "verify:polish": "node tools/electron-polish-check.js",
    "test:image-editor": "node tests/test-image-editor.js",
    "verify:image-editor": "node tools/electron-image-editor-check.js",
    "test:long-capture": "node tests/test-long-start.js && node tests/test-long-capture.js && node tests/test-long-session.js && node tests/test-region-capture.js",
    "test:long-browser": "node tools/long-capture-browser-check.js",
    "verify:long-capture": "node node_modules/electron/install.js && node tools/region-native-check.js && node tools/electron-long-clipboard-check.js && node tools/electron-long-native-check.js",
    "verify:panel-global": "node tools/electron-panel-global-check.js",
    "test:long-grid": "node tools/long-capture-grid-check.js",
    "test:long-columns": "node tools/long-capture-columns-check.js",
    "verify:glass": "node tools/glass-performance-check.js",
    "verify:workspace": "node tools/electron-workspace-check.js",
    "verify:windows": "node tools/window-stability-check.js",
    "verify:launcher": "node tools/launcher-workflows-check.js",
    "verify:release": "node tools/release-workflows-check.js",
    "verify:installer": "node tools/installer-lifecycle-check.js",
    "prepare:vendor": "node tools/prepare-vendor.js",
    "postinstall": "node tools/prepare-vendor.js",
    "predist:portable": "node tools/prepare-vendor.js",
    "predist": "node tools/prepare-vendor.js",
    "test:surfaces": "node tools/electron-surface-check.js",
    "screenshots": "node tools/product-screenshots.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.suira.desktop",
    "productName": "随序",
    "artifactName": "Suira-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pin-preload.js",
      "lib/**/*",
      "!lib/shortcut-fallback.js",
      "src/**/*",
      "!src/__fx_*",
      "assets/suira-icon.png",
      "assets/icon.ico",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs",
      "assets/tessdata/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/tessdata/**/*",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Suira-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "随序",
      "include": "build/installer.nsh",
      "runAfterFinish": false
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "SuiraMarkdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lunar-javascript": "1.7.7",
    "marked": "^18.1.2",
    "pinyin-pro": "^3.29.5",
    "tesseract.js": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huihui200739/suira-desktop.git"
  },
  "homepage": "https://github.com/huihui200739/suira-desktop#readme",
  "bugs": {
    "url": "https://github.com/huihui200739/suira-desktop/issues"
  }
}
