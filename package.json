    "test:island-store": "node tests/test-island-store.js",
    "test:island-render": "node tools/island-check.js",
    "test:notes-render": "node tools/notes-check.js",
    "test:keywatch": "node tests/test-key-watch.js",
    "test:actions": "node tests/test-actions.js",
    "test:capabilities": "node tests/test-capabilities.js",
    "test:keybindings": "node tests/test-keybindings.js",
    "test:flows": "node tests/test-panel-flows.js",
    "test:return": "node tests/test-return.js",
    "test:foreground": "node tests/test-foreground.js",
    "test:security": "node tests/test-security.js",
