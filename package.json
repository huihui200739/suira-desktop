{
  "name": "suira-desktop",
  "version": "0.2.0",
  "description": "随序 SUIRA：你的 Windows 随手工作台。截图、文字、剪贴板与任务匣共用一套内容与动作，顺手接住，让工作继续。",
  "main": "main.js",
  "author": "huihui200739",
  "license": "MIT",
  "scripts": {
    "start": "node tools/dev-start.js",
    "dev": "node tools/dev-start.js --dev",
    "clean": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/clean-dev-artifacts.ps1",
    "test": "node test-shortcut-fallback.js && node test-workspace.js && node test-core.js && node test-clipboard-session.js && node test-long-start.js && node test-long-capture.js && node test-long-session.js && node test-region-capture.js && node test-image-editor.js && node test-app-icons.js && node test-icon-disk-cache.js && node test-native-capture.js && node test-clipboard.js && node test-ocr.js && node test-translate.js && node test-notes.js && node test-island-store.js && node test-island.js && node test-island-wake.js && node test-actions.js && node test-capabilities.js && node test-keybindings.js && node test-panel-bindings.js && node test-panel-shortcuts.js && node test-panel-flows.js && node test-return.js && node test-foreground.js && node test-security.js && node test-key-watch.js && node test-display.js && node test-inject.js && node test-diagnostics.js && node test-ui.js && node test-render.js && node tools/panel-shot.js --check && node tools/island-check.js && node tools/notes-check.js && node tools/clipboardbar-check.js && node tools/confirm-check.js && node tools/overlay-check.js && node tools/shortcut-check.js",
    "test:core": "node test-core.js",
    "test:clipboard": "node test-clipboard.js",
    "test:ocr": "node test-ocr.js",
    "test:notes": "node test-notes.js",
    "test:translate": "node test-translate.js",
    "test:clipboardbar": "node tools/clipboardbar-check.js",
    "test:island": "node test-island.js && node test-island-store.js",
    "test:island-store": "node test-island-store.js",
    "test:island-render": "node tools/island-check.js",
    "test:notes-render": "node tools/notes-check.js",
    "test:keywatch": "node test-key-watch.js",
    "test:actions": "node test-actions.js",
    "test:capabilities": "node test-capabilities.js",
    "test:keybindings": "node test-keybindings.js",
    "test:flows": "node test-panel-flows.js",
    "test:return": "node test-return.js",
    "test:foreground": "node test-foreground.js",
    "test:security": "node test-security.js",
    "test:display": "node test-display.js",
    "test:inject": "node test-inject.js",
    "test:ui": "node test-ui.js",
    "test:render": "node test-render.js",
    "test:confirm": "node tools/confirm-check.js",
    "test:overlay": "node tools/overlay-check.js",
    "test:shortcut": "node tools/shortcut-check.js",
    "test:diagnostics": "node test-diagnostics.js",
    "diag": "electron . --diag",
    "verify:electron": "node tools/electron-real-check.js",
    "verify:ipc": "node tools/electron-verify.js",
    "verify:capture": "node tools/electron-capture-check.js",
    "verify:latency": "node tools/latency-live-check.js --idle",
    "audit:batch3": "node tools/fuyin-modules.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "verify:island": "node tools/electron-island-check.js",
    "verify:core": "node tools/electron-core-check.js",
    "verify:notes": "node tools/electron-notes-check.js",
    "test:panel": "node tools/panel-shot.js --check",
    "verify:panel": "node tools/electron-panel-check.js",
    "test:island-wake": "node test-island-wake.js",
    "test:app-icons": "node test-app-icons.js",
    "test:bindings": "node test-panel-bindings.js && node test-panel-shortcuts.js && node tools/panel-shot.js --check",
    "verify:bindings": "node tools/electron-bindings-check.js",
    "verify:polish": "node tools/electron-polish-check.js",
    "test:image-editor": "node test-image-editor.js",
    "verify:image-editor": "node tools/electron-image-editor-check.js",
    "test:long-capture": "node test-long-start.js && node test-long-capture.js && node test-long-session.js && node test-region-capture.js",
    "test:long-browser": "node tools/long-capture-browser-check.js",
    "verify:long-capture": "node node_modules/electron/install.js && node tools/region-native-check.js && node tools/electron-long-clipboard-check.js && node tools/electron-long-native-check.js",
    "verify:panel-global": "node tools/electron-panel-global-check.js",
    "test:long-grid": "node tools/long-capture-grid-check.js",
    "test:long-columns": "node tools/long-capture-columns-check.js",
    "verify:glass": "node tools/glass-performance-check.js",
    "verify:workspace": "node tools/electron-workspace-check.js",
    "prepare:vendor": "node tools/prepare-vendor.js",
    "postinstall": "node tools/prepare-vendor.js",
    "predist:portable": "node tools/prepare-vendor.js",
    "predist": "node tools/prepare-vendor.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.suira.desktop",
    "productName": "随序",
    "artifactName": "Suira-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pin-preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/suira-icon.png",
      "assets/icon.ico",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs",
      "assets/tessdata/**/*",
      "package.json",
      "assets/shortcut-fallback-host.cs"
    ],
    "asarUnpack": [
      "assets/tessdata/**/*",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs",
      "assets/shortcut-fallback-host.cs"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Suira-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "随序"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "pinyin-pro": "^3.29.5",
    "tesseract.js": "^5.1.1"
  }
}
