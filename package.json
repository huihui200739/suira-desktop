    "verify:relay": "node tools/relay-check.js",
    "verify:selection": "node tools/selection-check.js",
    "verify:tools": "node tools/new-tools-check.js",
    "test:ui-fixes": "node tools/ui-fixes-check.js",
    "test:workbench": "node tests/test-hints.js && node tests/test-glass-select-lifecycle.js && node tests/test-action-strip-lifecycle.js && node tests/test-sidebar.js && node tests/test-workbench-state.js && node tests/test-core.js && node tests/test-history-cleanup.js && node tests/test-actions.js && node tests/test-workspace.js && node tests/test-markdown-files.js",
    "verify:workbench": "node tools/workbench-check.js",
    "test:hints": "node tests/test-hints.js && node tests/test-glass-select-lifecycle.js && node tests/test-action-strip-lifecycle.js",
    "verify:hints": "node tools/hints-check.js"
  },
  "devDependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4"
  },
  "build": {
    "afterPack": "build/after-pack.js",
    "appId": "com.suira.desktop",
    "productName": "随序",
    "artifactName": "Suira-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "voice-preload.js",
      "pin-preload.js",
      "theme-preload.js",
      "lib/**/*",
      "vendor/miaoyan-windows/lib/preview.mjs",
      "src/**/*",
      "!src/__fx_*",
      "assets/suira-icon.png",
      "assets/icon.ico",
      "assets/licenses/**/*",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs",
      "assets/tessdata/**/*",
      "package.json",
      "assets/fonts/**/*"
    ],
    "asarUnpack": [
      "assets/tessdata/**/*",
      "assets/foreground-helper.ps1",
      "assets/foreground-host.cs",
      "assets/key-watch.ps1",
      "assets/key-watch-host.cs",
      "assets/island-pointer-host.cs",
      "assets/app-icon-host.cs",
      "assets/capture-host.cs",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/koffi-win32-x64/**/*",
      "assets/fonts/**/*",
      "lib/qr.js",
      "node_modules/jsqr/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Suira-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "随序",
      "include": "build/installer.nsh",
      "runAfterFinish": false
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "SuiraMarkdown",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "huihui200739",
        "repo": "suira-updates",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-updater": "6.8.11",
    "jsqr": "1.4.0",
    "koffi": "3.3.6",
    "lunar-javascript": "1.7.7",
    "marked": "^18.1.2",
    "opencc-js": "1.4.2",
    "pinyin-pro": "^3.29.5",
    "tesseract.js": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huihui200739/suira-desktop.git"
  },
  "homepage": "https://github.com/huihui200739/suira-desktop#readme",
  "bugs": {
    "url": "https://github.com/huihui200739/suira-desktop/issues"
  }
}
