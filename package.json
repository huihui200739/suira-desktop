ot.js --check && node tools/island-check.js && node tools/notes-check.js && node tools/clipboardbar-check.js && node tools/confirm-check.js && node tools/overlay-check.js && node tools/shortcut-check.js && node tools/ui-fixes-check.js",
    "test:core": "node tests/test-core.js",
    "test:voice": "node tests/test-voice-input.js",
